{
  "manifest_version": 3,
  "name": "NotebookLM Tag & Filter",
  "version": "1.0.0",
  "description": "Tag and filter NotebookLM chat messages by topic for easier navigation and organization.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://notebooklm.google.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
