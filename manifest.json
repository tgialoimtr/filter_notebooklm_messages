{
  "manifest_version": 3,
  "name": "NotebookLM Tag & Filter",
  "version": "2.0.0",
  "description": "Tag and filter NotebookLM chat messages via a sidebar panel.",
  "permissions": ["storage", "sidePanel", "activeTab", "tabs", "scripting"],
  "host_permissions": ["https://notebooklm.google.com/*"],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://notebooklm.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
