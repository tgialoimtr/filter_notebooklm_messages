{
  "manifest_version": 3,
  "name": "Chat Tag & Filter",
  "version": "3.0.0",
  "description": "Tag and filter chat messages across NotebookLM, ChatGPT, and more via a sidebar panel.",
  "permissions": ["storage", "sidePanel", "activeTab", "tabs", "scripting"],
  "host_permissions": [
    "https://notebooklm.google.com/*",
    "https://chatgpt.com/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://notebooklm.google.com/*",
        "https://chatgpt.com/*"
      ],
      "js": ["adapters.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
